## Visual Studio / C# standard .gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.VisualState.xml

# Visual Studio 2015/2017/2019/2022 cache and state directories
.vs/
.vscode/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
[Bb]ld/
[Aa]rch/

# NuGet Packages
*.nupkg
packages/
**/packages/

# SQL Server local database log files (auto-generated by LocalDB on attach)
*.ldf

# Temporary and backup files
*.tmp
*.log
*.bak
*.cache
Thumbs.db
[Ee]xpress/
